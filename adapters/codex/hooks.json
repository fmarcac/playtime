{
  "SessionStart": [
    {
      "hooks": [{ "type": "command", "command": "__EMIT__ codex SessionStart", "timeout": 5 }]
    }
  ],
  "SessionEnd": [
    {
      "hooks": [{ "type": "command", "command": "__EMIT__ codex SessionEnd", "timeout": 5 }]
    }
  ],
  "UserPromptSubmit": [
    {
      "hooks": [{ "type": "command", "command": "__EMIT__ codex UserPromptSubmit", "timeout": 5 }]
    }
  ],
  "Stop": [
    {
      "hooks": [{ "type": "command", "command": "__EMIT__ codex Stop", "timeout": 5 }]
    }
  ],
  "Notification": [
    {
      "hooks": [{ "type": "command", "command": "__EMIT__ codex Notification", "timeout": 5 }]
    }
  ],
  "PostToolUse": [
    {
      "matcher": ".*",
      "hooks": [{ "type": "command", "command": "__EMIT__ codex PostToolUse", "timeout": 5 }]
    }
  ]
}
